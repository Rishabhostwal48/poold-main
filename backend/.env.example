GROQ_API_KEY=
GROQ_MODEL_TEXT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_STT=whisper-large-v3-turbo
