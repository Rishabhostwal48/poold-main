DB_SSL=false

# Amazon Cognito Configuration (User Pool provisioned externally)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# Amazon S3 Storage Configuration
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# AWS Credentials (or use IAM Role on EC2/ECS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
